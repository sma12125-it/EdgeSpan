<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EdgeSpan.Windows.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Windows 11 Settings palette. Pane and page are transparent so Mica shows through on Windows 11;
             BgBrush is the solid fallback used on Windows 10. Accent #3B6CFF, connected/teal #14B8A6. -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush" Color="#202020"/>
          <SolidColorBrush x:Key="SideBrush" Color="Transparent"/>
          <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>
          <SolidColorBrush x:Key="MapBrush" Color="#202020"/>
          <SolidColorBrush x:Key="CardHoverBrush" Color="#323232"/>
          <SolidColorBrush x:Key="CardSolidBrush" Color="#2B2B2B"/>
          <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#C5C5C5"/>
          <SolidColorBrush x:Key="LineBrush" Color="#1A000000"/>
          <SolidColorBrush x:Key="CardLineBrush" Color="#1D1D1D"/>
          <SolidColorBrush x:Key="NavHoverBrush" Color="#0FFFFFFF"/>
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#0FFFFFFF"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#7D9BFF"/>
          <SolidColorBrush x:Key="AccentFillBrush" Color="#3B6CFF"/>
          <SolidColorBrush x:Key="MintBrush" Color="#14B8A6"/>
          <SolidColorBrush x:Key="GoldBrush" Color="#F0B429"/>
          <SolidColorBrush x:Key="IconBrush" Color="#E6E6E6"/>
          <SolidColorBrush x:Key="SearchBrush" Color="#0BFFFFFF"/>
          <SolidColorBrush x:Key="PinCardBrush" Color="#1414B8A6"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3"/>
          <SolidColorBrush x:Key="SideBrush" Color="Transparent"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MapBrush" Color="#F3F3F3"/>
          <SolidColorBrush x:Key="CardHoverBrush" Color="#FBFBFB"/>
          <SolidColorBrush x:Key="CardSolidBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#5D5D5D"/>
          <SolidColorBrush x:Key="LineBrush" Color="#0F000000"/>
          <SolidColorBrush x:Key="CardLineBrush" Color="#E5E5E5"/>
          <SolidColorBrush x:Key="NavHoverBrush" Color="#09000000"/>
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#0F000000"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#3B6CFF"/>
          <SolidColorBrush x:Key="AccentFillBrush" Color="#3B6CFF"/>
          <SolidColorBrush x:Key="MintBrush" Color="#0F9488"/>
          <SolidColorBrush x:Key="GoldBrush" Color="#A87408"/>
          <SolidColorBrush x:Key="IconBrush" Color="#1A1A1A"/>
          <SolidColorBrush x:Key="SearchBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="PinCardBrush" Color="#1414B8A6"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3B6CFF"/>
        <ColorPaletteResources x:Key="Dark" Accent="#3B6CFF"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, avares://EdgeSpan/Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans, avares://EdgeSpan/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn, Inter, sans-serif"/>
      <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <!-- Navigation items: icon + label, rounded hover, accent pill on the selected item. -->
    <Style Selector="WrapPanel.ctrl > :is(Control)">
      <Setter Property="Margin" Value="0,2,8,2"/>
    </Style>
    <Style Selector="Border.compact TextBlock.navlabel">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ToggleButton.seg">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="#3B6CFF"/>
      <Setter Property="BoxShadow" Value="0 1 2 0 #22000000"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
    </Style>
    <Style Selector="Button.nav Border.pill">
      <Setter Property="Width" Value="3"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="CornerRadius" Value="1.5"/>
      <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav.selected Border.pill">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.nav.selected TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource IconBrush}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Path.icon.big">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="Button.method">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.method:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#5580FF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <!-- Generic rounded card (Win11 radius 6-8, hairline stroke, no heavy shadow). -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <!-- Setting row: icon | title + description | control on the far side. -->
    <Style Selector="Border.setting">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="MinHeight" Value="68"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style Selector="Border.setting.sub">
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="52,10,16,10"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.desc">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,18,0,6"/>
    </Style>
    <!-- Expander as a setting card that unfolds into sub rows. -->
    <Style Selector="Expander.setting">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardLineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style Selector="Expander.setting /template/ ToggleButton#ExpanderHeader">
      <Setter Property="MinHeight" Value="68"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardLineBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="{DynamicResource SearchBrush}"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1,1,1,2"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="{DynamicResource MintBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
      <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
  </Application.Styles>
</Application>
