<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EdgeSpan.Windows.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush" Color="#202020"/>
          <SolidColorBrush x:Key="SideBrush" Color="#1C1C1C"/>
          <SolidColorBrush x:Key="CardBrush" Color="#2C2C2C"/>
          <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#C8C8C8"/>
          <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A"/>
          <SolidColorBrush x:Key="NavHoverBrush" Color="#333333"/>
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#2A3A48"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
          <SolidColorBrush x:Key="MintBrush" Color="#3DDC84"/>
          <SolidColorBrush x:Key="GoldBrush" Color="#F0B429"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3"/>
          <SolidColorBrush x:Key="SideBrush" Color="#F9F9F9"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#5D5D5D"/>
          <SolidColorBrush x:Key="LineBrush" Color="#E5E5E5"/>
          <SolidColorBrush x:Key="NavHoverBrush" Color="#EBEBEB"/>
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#D6E8F7"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
          <SolidColorBrush x:Key="MintBrush" Color="#0E7A3D"/>
          <SolidColorBrush x:Key="GoldBrush" Color="#A87408"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://EdgeSpan/Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans, avares://EdgeSpan/Assets/Fonts/Vazirmatn-Regular.ttf#Vazirmatn, Inter, sans-serif"/>
      <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.method">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.method:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0067C0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BoxShadow" Value="0 2 8 0 #14000000"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="{DynamicResource MintBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
  </Application.Styles>
</Application>
