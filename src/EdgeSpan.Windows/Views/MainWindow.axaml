<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:EdgeSpan.Windows.Controls"
        x:Class="EdgeSpan.Windows.Views.MainWindow"
        Title="EdgeSpan"
        Width="1180" Height="800"
        MinWidth="390" MinHeight="620"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource InkBrush}"
        WindowStartupLocation="CenterScreen"
        Cursor="Arrow">
  <!-- Windows 11 Settings layout: nav pane (header card, search, icon items with accent pill) + page with large title and setting cards. -->
  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="292"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border x:Name="SideNav" Background="{DynamicResource SideBrush}" Padding="12,16,8,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="4,0,4,14">
          <TextBlock Text="EdgeSpan" FontSize="12" Margin="4,0,0,4"/>
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True" Background="{DynamicResource CardSolidBrush}">
              <Image Source="/Assets/icon.png" Width="48" Height="48"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="2">
              <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource MintBrush}" IsVisible="{Binding ShowConnectedView}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Classes="desc" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="170"/>
              </StackPanel>
              <TextBlock Text="{Binding VersionShort}" Classes="desc"/>
            </StackPanel>
          </Grid>
          <Grid>
            <TextBox Classes="search" Text="{Binding SearchText}" Watermark="{Binding Ui[findSetting]}" Padding="10,7,34,6"/>
            <Path Classes="icon" Data="M 7,1 A 6,6 0 1 1 6.99,1 M 11.5,11.5 L 17,17" Width="13" Height="13" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False"/>
          </Grid>
        </StackPanel>
        <StackPanel Spacing="3">
          <Button Classes="nav" Classes.selected="{Binding HomeSelected}" Command="{Binding ShowHomeCommand}">
            <Grid ColumnDefinitions="3,40,*">
              <Border Classes="pill"/>
              <ContentControl Grid.Column="1" HorizontalAlignment="Center"><Path Classes="icon" Data="M 2,8 L 9,2 L 16,8 M 4,7 L 4,16 L 14,16 L 14,7 M 7.5,16 L 7.5,11 L 10.5,11 L 10.5,16"/></ContentControl>
              <TextBlock Grid.Column="2" Text="{Binding Ui[navHome]}" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding ArrangeSelected}" Command="{Binding ShowArrangeCommand}">
            <Grid ColumnDefinitions="3,40,*">
              <Border Classes="pill"/>
              <ContentControl Grid.Column="1" HorizontalAlignment="Center"><Path Classes="icon" Data="M 1,3 L 11,3 L 11,10 L 1,10 Z M 4,13 L 8,13 M 6,10 L 6,13 M 13,6 L 17,6 L 17,14 L 13,14 Z"/></ContentControl>
              <TextBlock Grid.Column="2" Text="{Binding Ui[navArrange]}" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding DevicesNavSelected}" Command="{Binding ShowDevicesCommand}">
            <Grid ColumnDefinitions="3,40,*">
              <Border Classes="pill"/>
              <ContentControl Grid.Column="1" HorizontalAlignment="Center"><Path Classes="icon" Data="M 4,1 L 14,1 L 14,17 L 4,17 Z M 8,14.5 L 10,14.5"/></ContentControl>
              <TextBlock Grid.Column="2" Text="{Binding Ui[navDevicesW]}" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding TransfersSelected}" Command="{Binding ShowTransfersCommand}">
            <Grid ColumnDefinitions="3,40,*">
              <Border Classes="pill"/>
              <ContentControl Grid.Column="1" HorizontalAlignment="Center"><Path Classes="icon" Data="M 2,6 L 15,6 M 11,2 L 15,6 L 11,10 M 16,12 L 3,12 M 7,8 L 3,12 L 7,16"/></ContentControl>
              <TextBlock Grid.Column="2" Text="{Binding Ui[navTransfers]}" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding SettingsSelected}" Command="{Binding ShowSettingsCommand}">
            <Grid ColumnDefinitions="3,40,*">
              <Border Classes="pill"/>
              <ContentControl Grid.Column="1" HorizontalAlignment="Center"><Path Classes="icon" Data="M 9,6 A 3,3 0 1 1 8.99,6 M 9,1 L 9,3 M 9,15 L 9,17 M 1,9 L 3,9 M 15,9 L 17,9 M 3.3,3.3 L 4.7,4.7 M 13.3,13.3 L 14.7,14.7 M 3.3,14.7 L 4.7,13.3 M 13.3,4.7 L 14.7,3.3"/></ContentControl>
              <TextBlock Grid.Column="2" Text="{Binding Ui[navSettings]}" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="TopNav" IsVisible="False" Padding="10">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="ghost" Classes.selected="{Binding HomeSelected}" Content="{Binding Ui[navHome]}" Command="{Binding ShowHomeCommand}"/>
            <Button Classes="ghost" Classes.selected="{Binding ArrangeSelected}" Content="{Binding Ui[navArrange]}" Command="{Binding ShowArrangeCommand}"/>
            <Button Classes="ghost" Classes.selected="{Binding DevicesNavSelected}" Content="{Binding Ui[navDevicesW]}" Command="{Binding ShowDevicesCommand}"/>
            <Button Classes="ghost" Classes.selected="{Binding TransfersSelected}" Content="{Binding Ui[navTransfers]}" Command="{Binding ShowTransfersCommand}"/>
            <Button Classes="ghost" Classes.selected="{Binding SettingsSelected}" Content="{Binding Ui[navSettings]}" Command="{Binding ShowSettingsCommand}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="1" x:Name="TitleRow" Margin="32,22,32,14" MaxWidth="1000" ColumnDefinitions="*,Auto">
        <TextBlock Classes="h1" Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis"/>
        <Border Grid.Column="1" IsVisible="{Binding ShowSaved}" Background="{DynamicResource PinCardBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Ui[savedChip]}" Foreground="{DynamicResource MintBrush}" FontSize="12"/>
        </Border>
      </Grid>
      <ScrollViewer x:Name="Pages" Grid.Row="2" Padding="32,0,32,48" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageStack" Spacing="0" MaxWidth="1000" HorizontalAlignment="Stretch">

          <!-- HOME: connect flow + live status -->
          <StackPanel IsVisible="{Binding ShowHome}" Spacing="0">
            <StackPanel IsVisible="{Binding ShowConnect}" Spacing="3">
              <Border Classes="card" Padding="20" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding BrandKicker}" Classes="kicker"/>
                  <TextBlock Text="{Binding ConnectTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ConnectLead}" Classes="desc" FontSize="13"/>
                </StackPanel>
              </Border>
              <StackPanel Spacing="3" IsVisible="{Binding ShowMethodCards}">
              <Button Classes="method" Command="{Binding ChooseUsbCommand}">
                <Grid ColumnDefinitions="150,*,Auto">
                  <c:LinkSketch Method="usb" Phase="idle" Height="84" IsHitTestVisible="False"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                    <TextBlock Classes="title" Text="{Binding UsbTitle}" FontWeight="SemiBold"/>
                    <TextBlock Classes="desc" Text="{Binding UsbBody}"/>
                  </StackPanel>
                  <Path Grid.Column="2" Classes="icon" Data="M 6,3 L 12,9 L 6,15" Width="12" Height="12"/>
                </Grid>
              </Button>
              <Button Classes="method" Command="{Binding ChooseLanCommand}">
                <Grid ColumnDefinitions="150,*,Auto">
                  <c:LinkSketch Method="lan" Phase="idle" Height="84" IsHitTestVisible="False"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                    <TextBlock Classes="title" Text="{Binding LanTitle}" FontWeight="SemiBold"/>
                    <TextBlock Classes="desc" Text="{Binding LanBody}"/>
                  </StackPanel>
                  <Path Grid.Column="2" Classes="icon" Data="M 6,3 L 12,9 L 6,15" Width="12" Height="12"/>
                </Grid>
              </Button>
              <Button Classes="method" Command="{Binding ChooseRelayCommand}">
                <Grid ColumnDefinitions="150,*,Auto">
                  <c:LinkSketch Method="relay" Phase="idle" Height="84" IsHitTestVisible="False"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="2">
                    <TextBlock Classes="title" Text="{Binding RelayTitle}" FontWeight="SemiBold"/>
                    <TextBlock Classes="desc" Text="{Binding RelayBody}"/>
                  </StackPanel>
                  <Path Grid.Column="2" Classes="icon" Data="M 6,3 L 12,9 L 6,15" Width="12" Height="12"/>
                </Grid>
              </Button>
              </StackPanel>
              <StackPanel Spacing="8" IsVisible="{Binding ShowConnectWork}">
                <Border Classes="card" Height="220" Padding="8">
                  <c:LinkSketch Method="{Binding ActiveMethod}" Phase="{Binding ConnectPhase}"/>
                </Border>
                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding ConnectStatus}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConnectDetail}" Classes="desc" IsVisible="{Binding HasConnectDetail}"/>
                    <TextBlock Text="{Binding SamsungHint}" Classes="desc" IsVisible="{Binding ShowRetry}"/>
                    <Button Classes="ghost" Content="{Binding OpenSamsungLabel}" Command="{Binding OpenSamsungCommand}" HorizontalAlignment="Left" IsVisible="{Binding ShowRetry}"/>
                    <StackPanel Spacing="8" IsVisible="{Binding ShowLanTools}">
                      <TextBlock Text="{Binding PinLabel}" Classes="desc"/>
                      <TextBlock Text="{Binding PinText}" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding PairingVisible}"/>
                      <Image Source="{Binding QrImage}" Width="180" Height="180" HorizontalAlignment="Left" IsVisible="{Binding PairingVisible}"/>
                      <TextBlock Text="{Binding DiscoveredLabel}" FontWeight="SemiBold"/>
                      <ItemsControl ItemsSource="{Binding Peers}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Detail}" Classes="desc"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="8" IsVisible="{Binding ShowRelayTools}">
                      <TextBlock Text="{Binding RelayLabel}"/>
                      <TextBox Text="{Binding RelayUrl, Mode=TwoWay}"/>
                      <TextBlock Text="{Binding StunLabel}"/>
                      <Grid ColumnDefinitions="*,120">
                        <TextBox Text="{Binding StunHost, Mode=TwoWay}" Watermark="{Binding StunHint}" Margin="0,0,8,0"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding StunPort}" Minimum="1" Maximum="65535"/>
                      </Grid>
                      <TextBlock Text="{Binding PublicHostLabel}"/>
                      <Grid ColumnDefinitions="*,120">
                        <TextBox Text="{Binding PublicHost, Mode=TwoWay}" Watermark="203.0.113.10" Margin="0,0,8,0"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding PublicPort}" Minimum="0" Maximum="65535"/>
                      </Grid>
                      <TextBlock Text="{Binding PublicHostHint}" Classes="desc"/>
                      <TextBlock Text="{Binding PinText}" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding PairingVisible}"/>
                      <Image Source="{Binding QrImage}" Width="180" Height="180" HorizontalAlignment="Left" IsVisible="{Binding PairingVisible}"/>
                      <Button Classes="primary" Content="{Binding SaveLabel}" Command="{Binding ChooseRelayCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary" Content="{Binding RetryLabel}" Command="{Binding RetryConnectCommand}" IsVisible="{Binding ShowRetry}"/>
                      <Button Classes="ghost" Content="{Binding SwitchMethodLabel}" Command="{Binding SwitchMethodCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Spacing="3" IsVisible="{Binding ShowConnectedView}">
                <Border Classes="card" Padding="8" Height="230" Margin="0,0,0,5">
                  <c:LinkSketch Method="{Binding ActiveMethod}" Phase="connected"/>
                </Border>
                <Border Classes="setting">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 6,1 L 12,1 L 12,7 L 6,7 Z M 4,7 L 14,7 L 14,13 L 4,13 Z M 9,13 L 9,17"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding ConnectedTitle}"/>
        <TextBlock Classes="desc" Text="{Binding LatencyLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding RttText}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="{DynamicResource MintBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center"><TextBlock Text="{Binding ConnectKind}" Foreground="White" FontWeight="SemiBold"/></Border><Button Classes="ghost" Content="{Binding SwitchMethodLabel}" Command="{Binding SwitchMethodCommand}"/></StackPanel>
    </Grid>
  </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowOverview}">
              <TextBlock Classes="section" Text="{Binding Ui[statusSection]}"/>
              <Border Classes="card" Margin="0,0,0,3">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource MintBrush}" VerticalAlignment="Top" Margin="2,9,14,0"/>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ListenText}" Classes="desc"/>
                    <TextBlock Text="{Binding LicenseText}" Foreground="{DynamicResource GoldBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding SwitchShortcutLine}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding InputTraceLine}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="setting">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 9,1 A 5,6 0 0 1 14,7 L 14,11 A 5,6 0 0 1 4,11 L 4,7 A 5,6 0 0 1 9,1 Z M 9,1 L 9,6"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding ActiveText}"/>
        <TextBlock Classes="desc" Text="{Binding LockText}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"></StackPanel>
    </Grid>
  </Border>
              <Border Classes="setting">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 9,1 A 8,8 0 1 1 8.99,1 M 1,9 L 17,9 M 9,1 Q 4,9 9,17 M 9,1 Q 14,9 9,17"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding RttText}"/>
        <TextBlock Classes="desc" Text="{Binding PathText}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"></StackPanel>
    </Grid>
  </Border>
              <Border Classes="setting">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 2,5 L 16,5 L 16,13 L 2,13 Z M 5,8 L 5,10 M 8,8 L 8,10 M 11,8 L 11,10 M 14,8 L 14,10"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding PacketText}"/>
        <TextBlock Classes="desc" Text="{Binding InjectionHint}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"></StackPanel>
    </Grid>
  </Border>
              <TextBlock Classes="section" Text="{Binding Ui[quickActions]}"/>
              <Border Classes="setting">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 2,5 L 14,5 M 11,2 L 14,5 L 11,8 M 16,13 L 4,13 M 7,10 L 4,13 L 7,16"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding SwitchButton}"/>
        <TextBlock Classes="desc" Text="{Binding SwitchShortcutLine}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="primary" Content="{Binding SwitchButton}" Command="{Binding CycleCommand}"/></StackPanel>
    </Grid>
  </Border>
              <Border Classes="setting">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 3,8 L 15,8 L 15,17 L 3,17 Z M 5,8 L 5,5 A 4,4 0 0 1 13,5 L 13,8"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding LockButton}"/>
        <TextBlock Classes="desc" Text="{Binding LockText}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="ghost" Content="{Binding LockButton}" Command="{Binding LockCommand}"/></StackPanel>
    </Grid>
  </Border>
            </StackPanel>
          </StackPanel>

          <!-- ARRANGE: drag map like Settings > Display -->
          <StackPanel IsVisible="{Binding ShowArrange}">
            <Border Classes="card" Padding="16" Margin="0,0,0,3">
              <StackPanel Spacing="10">
                <TextBlock Classes="desc" Text="{Binding Ui[arrangeHint]}"/>
                <Border Height="300" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource MapBrush}" BorderBrush="{DynamicResource CardLineBrush}" BorderThickness="1">
                  <c:LayoutCanvas x:Name="Map" Devices="{Binding LayoutDevices}" Monitors="{Binding Monitors}" ActiveId="{Binding ActiveDeviceId}" SelectedId="{Binding SelectedDeviceId}" HostLabel="{Binding HostScreenLabel}"/>
                </Border>
                <TextBlock Text="{Binding ArrangeNote}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" IsVisible="{Binding HasArrangeNote}"/>
                <WrapPanel>
                  <Button Classes="ghost" Content="{Binding Ui[identify]}" Command="{Binding IdentifyCommand}" Margin="0,0,8,4"/>
                  <Button Classes="ghost" Content="{Binding Ui[detect]}" Command="{Binding DetectCommand}" Margin="0,0,8,4"/>
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding DragHint}" Classes="desc" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Content="{Binding SimulateLeaveLabel}" Command="{Binding SimulateLeaveCommand}"/>
                    <Button Classes="ghost" Content="{Binding SimulateReturnLabel}" Command="{Binding SimulateReturnCommand}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding ProblemText}" Foreground="{DynamicResource GoldBrush}" TextWrapping="Wrap" IsVisible="{Binding HasProblems}" Margin="2,6"/>
            <TextBlock Text="{Binding LayoutHint}" Classes="desc" Margin="2,6"/>
            <Border Classes="setting" IsVisible="{Binding !HasEditor}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 4,1 L 14,1 L 14,17 L 4,17 Z M 8,14.5 L 10,14.5"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding NoDeviceSelected}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"></StackPanel>
    </Grid>
  </Border>
            <Expander Classes="setting" IsExpanded="True" IsVisible="{Binding HasEditor}">
    <Expander.Header>
      <Grid ColumnDefinitions="36,*">
        <Path Classes="icon big" Data="M 2,10 L 2,2 L 10,2 M 6,16 L 16,16 L 16,6"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="{Binding Ui[placement]}"/>
          <TextBlock Classes="desc" Text="{Binding Ui[placementHint]}"/>
        </StackPanel>
      </Grid>
    </Expander.Header>
    <StackPanel>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding PcEdgeLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{Binding PcEdgeIndex}" Width="160">
          <ComboBoxItem Content="{Binding LeftLabel}"/><ComboBoxItem Content="{Binding RightLabel}"/>
          <ComboBoxItem Content="{Binding TopLabel}"/><ComboBoxItem Content="{Binding BottomLabel}"/>
        </ComboBox></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding ReturnEdgeLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{Binding ReturnEdgeIndex}" Width="160">
          <ComboBoxItem Content="{Binding LeftLabel}"/><ComboBoxItem Content="{Binding RightLabel}"/>
          <ComboBoxItem Content="{Binding TopLabel}"/><ComboBoxItem Content="{Binding BottomLabel}"/>
        </ComboBox></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding AnchorLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{Binding AnchorIndex}" Width="160"><ComboBoxItem Content="{Binding EdgeLabel}"/><ComboBoxItem Content="{Binding CornerLabel}"/></ComboBox></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding CornerLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{Binding CornerIndex}" Width="160"><ComboBoxItem Content="{Binding TopLeftLabel}"/><ComboBoxItem Content="{Binding TopRightLabel}"/><ComboBoxItem Content="{Binding BottomLeftLabel}"/><ComboBoxItem Content="{Binding BottomRightLabel}"/></ComboBox></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding OffsetLabel}"/>
        <TextBlock Classes="desc" Text="{Binding OffsetHint}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><NumericUpDown Value="{Binding EditOffset}" Minimum="0" Maximum="20000" Width="140"/></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding SpanLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><NumericUpDown Value="{Binding EditSpan}" Minimum="0" Maximum="20000" Width="140"/></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding CornerSizeLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><NumericUpDown Value="{Binding EditCornerSize}" Minimum="20" Maximum="2000" Width="140"/></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding SpeedLabel}"/>
        <TextBlock Classes="desc" Text="{Binding SpeedHint}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><NumericUpDown Value="{Binding EditSpeed}" Minimum="0.1" Maximum="8" Width="140" Increment="0.1" FormatString="0.0"/></StackPanel>
    </Grid>
  </Border>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding ApplyLabel}"/>
        <TextBlock Classes="desc" Text="{Binding SavedText}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="primary" Content="{Binding ApplyLabel}" Command="{Binding SaveDeviceCommand}"/></StackPanel>
    </Grid>
  </Border>
    </StackPanel>
  </Expander>
          </StackPanel>

          <!-- DEVICES + pairing -->
          <StackPanel IsVisible="{Binding ShowDevicesPage}">
            <TextBlock Classes="section" Text="{Binding Ui[pairedDevices]}" Margin="2,0,0,6"/>
            <Border Classes="setting" IsVisible="{Binding NoDevices}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 4,1 L 14,1 L 14,17 L 4,17 Z M 8,14.5 L 10,14.5"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding EmptyDevices}"/>
        <TextBlock Classes="desc" Text="{Binding EmptyHint}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"></StackPanel>
    </Grid>
  </Border>
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="Transparent" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="CornerRadius" Value="6"/></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="setting" Margin="0">
                    <Grid ColumnDefinitions="36,*,Auto">
                      <Path Classes="icon big" Data="M 4,1 L 14,1 L 14,17 L 4,17 Z M 8,14.5 L 10,14.5"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="title" Text="{Binding Name}"/>
                        <TextBlock Classes="desc" Text="{Binding Detail}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="{DynamicResource MintBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="setting" IsVisible="{Binding !NoDevices}">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="36" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Classes="icon big" Data="M 4,1 L 14,1 L 14,17 L 4,17 Z M 8,14.5 L 10,14.5"/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding RemoveLabel}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="ghost" Content="{Binding RemoveLabel}" Command="{Binding RemoveDeviceCommand}"/></StackPanel>
    </Grid>
  </Border>
            <TextBlock Classes="section" Text="{Binding DiscoveredLabel}"/>
            <ItemsControl ItemsSource="{Binding Peers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="setting">
                    <Grid ColumnDefinitions="36,*,Auto">
                      <Path Classes="icon big" Data="M 1,6 Q 9,-1 17,6 M 4,9.5 Q 9,5 14,9.5 M 7,13 Q 9,11 11,13 M 9,16 L 9,16.2"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="title" Text="{Binding Name}"/>
                        <TextBlock Classes="desc" Text="{Binding Detail}"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="primary" Content="{Binding $parent[Window].DataContext.AddDeviceLabel}"
                              Command="{Binding $parent[Window].DataContext.AddPeerCommand}" CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="section" Text="{Binding Ui[pairNew]}"/>
            <Expander Classes="setting" IsExpanded="True">
    <Expander.Header>
      <Grid ColumnDefinitions="36,*">
        <Path Classes="icon big" Data="M 3,8 L 15,8 L 15,17 L 3,17 Z M 6,8 L 6,5 A 3,3 0 0 1 12,5 L 12,8"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="{Binding StartPairingLabel}"/>
          <TextBlock Classes="desc" Text="{Binding QrHint}"/>
        </StackPanel>
      </Grid>
    </Expander.Header>
    <StackPanel>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <ContentControl Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"><Panel/></ContentControl>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
        <TextBlock Classes="title" Text="{Binding StartPairingLabel}"/>
        <TextBlock Classes="desc" Text="{Binding Ui[pairNewHint]}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="primary" Content="{Binding StartPairingLabel}" Command="{Binding StartPairingCommand}"/></StackPanel>
    </Grid>
  </Border>
      <Border Classes="setting sub" IsVisible="{Binding PairingVisible}" Background="{DynamicResource PinCardBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="M 2,8 L 7,13 L 16,3" Stroke="{DynamicResource MintBrush}" StrokeThickness="2.2" StrokeJoin="Round" StrokeLineCap="Round" Width="18" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding PairingState}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding PinLabel}" Classes="desc"/>
            <TextBlock Text="{Binding PinText}" FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
            <Button Classes="ghost" Content="{Binding CopyPinLabel}" Command="{Binding CopyPinCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
          <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="8" VerticalAlignment="Top">
            <Image Source="{Binding QrImage}" Width="220" Height="220"/>
          </Border>
        </Grid>
      </Border>
    </StackPanel>
  </Expander>
            <Expander Classes="setting" IsExpanded="False">
    <Expander.Header>
      <Grid ColumnDefinitions="36,*">
        <Path Classes="icon big" Data="M 9,2 L 9,16 M 2,9 L 16,9"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="{Binding ManualAddLabel}"/>
          <TextBlock Classes="desc" Text="{Binding Ui[manualHint]}"/>
        </StackPanel>
      </Grid>
    </Expander.Header>
    <StackPanel>
<Border Classes="setting sub">
    <Grid ColumnDefinitions="Auto,*,Auto">
